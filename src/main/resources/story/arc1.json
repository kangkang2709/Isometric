    {
      "id": "healer_backstory",
      "title": "Ký Ức Mùi Khói Bếp",
      "description": "Tìm hiểu câu chuyện của Lyra, người phục vụ tại quán rượu cũ kỹ – và lý do vì sao cô ấy luôn sẵn lòng giúp đỡ lữ khách.",
      "scenes": [
        {
          "id": "scene_intro",
          "background": "transparent.png",
          "music": "soft_fireplace.mp3",
          "sound_effects": ["clinking_glasses.wav", "murmur.wav"],
          "dialogues": [
            {
              "character": "MC",
              "characterImage": "mc_default.png",
              "text": "Khá đông nhỉ… Nhưng người kia đứng ở góc bếp trông có vẻ đặc biệt..."
            },
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Ồ, một gương mặt lạ. Chào mừng đến với quán 'Lửa & Lá' – ta là Lyra. Ngươi cần gì? Một món ăn? Hay là một câu chuyện?"
            }
          ],
          "choices": [
            {
              "text": "Tiếp tục câu chuyện.",
              "next_scene": "scene_start",
              "required_item": null,
              "reward_item": null
            },
            {
              "text": "Hồi phục.",
              "next_scene": "scene_healed",
              "required_item": "CCCD",
              "reward_item": null
            }
          ]
        },
        {
          "id": "scene_healed",
          "background": "transparent.png",
          "music": "sad_piano.mp3",
          "dialogues": [
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Hẹn gặp lại quý khách lần sau"
            }
          ],
          "choices": [
          ]
        },
        {
          "id": "scene_not_enough_item",
          "background": "transparent.png",
          "music": "sad_piano.mp3",
          "dialogues": [
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Qúy khách chưa có minh chứng [Item `CCCD`]. Tôi không thể giúp gì nếu bạn không có minh chứng thân phận."
            }
          ],
          "choices": [
          ]
        },
        {
          "id": "scene_start",
          "background": "tavern_interior.png",
          "music": "casual_tavern.mp3",
          "dialogues": [
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Bạn muốn nghe câu chuyện của ta? Hay chỉ muốn biết ta đã làm gì ở đây?"
            }
          ],
          "choices": [
            {
              "text": "Kể ta nghe câu chuyện của cô đi.",
              "next_scene": "scene_story_1",
              "required_item": null,
              "reward_item": null
            },
            {
              "text": "Cô làm việc ở đây đã lâu chưa?",
              "next_scene": "scene_personality",
              "required_item": null,
              "reward_item": null
            },
            {
              "text": "Không có gì, chỉ đi ngang qua thôi.",
              "next_scene": "scene_end",
              "required_item": null,
              "reward_item": null
            }
          ]
        },
        {
          "id": "scene_story_1",
          "background": "tavern_interior.png",
          "music": "nostalgic_theme.mp3",
          "dialogues": [
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Trước đây ta từng là học viên chữa thương ở học viện thủ đô. Nhưng một sai sót nhỏ… đã cướp đi cơ hội trở thành pháp sư y thuật."
            },
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Ta quay về quê và mở quán này cùng mẹ. Từ đó, ta học cách dùng món ăn làm dịu nỗi đau và hồi phục cơ thể – một cách khác để chữa lành, đúng không?"
            }
          ],
          "choices": [
            {
              "text": "Đó là một cách chữa lành đẹp đẽ.",
              "next_scene": "scene_more_past",
              "required_item": null,
              "reward_item": null
            },
            {
              "text": "Quay lại lựa chọn khác.",
              "next_scene": "scene_start",
              "required_item": null,
              "reward_item": null
            }
          ]
        },
        {
          "id": "scene_more_past",
          "background": "tavern_kitchen.png",
          "music": "healing_memory.mp3",
          "dialogues": [
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Ngươi biết không… có lần một chiến binh gục ngã ngay tại ngưỡng cửa quán. Ta chỉ còn đúng một nồi súp dược thảo – và nó đã cứu được anh ta."
            },
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Từ đó, ta tự hứa sẽ nấu ăn không chỉ bằng tay – mà bằng cả trái tim."
            }
          ],
          "choices": [
            {
              "text": "Câu chuyện đó làm tôi nhớ tới mẹ tôi… Còn cô thì sao?",
              "next_scene": "scene_mother_memory",
              "required_item": null,
              "reward_item": null
            },
            {
              "text": "Trở lại đầu.",
              "next_scene": "scene_start",
              "required_item": null,
              "reward_item": null
            }
          ]
        },
        {
          "id": "scene_mother_memory",
          "background": "tavern_kitchen_old.png",
          "music": "memory_theme.mp3",
          "dialogues": [
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Mẹ ta là người đầu tiên dạy ta cách dùng thảo dược – không chỉ để chữa lành vết thương, mà còn là chữa lành tâm hồn."
            },
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Bà luôn nói: 'Một chén súp ngon có thể xoa dịu những nỗi đau mà lời nói không thể.'"
            },
            {
              "character": "Lyra",
              "characterImage": "npc_healer.png",
              "text": "Khi bà qua đời, ta giữ lại quán này – như một lời hứa chưa trọn vẹn."
            }
          ],
          "choices": [
            {
              "text": "Tôi tin bà ấy sẽ tự hào về cô.",
              "next_scene": "scene_gratitude",
              "required_item": null,
              "reward_item": null
            },
            {
              "text": "Trở lại lựa chọn trước.",
              "next_scene": "scene_start",
              "required_item": null,
              "reward_item": null
            }
          ]
        },
        {
          "id": "scene_gratitude",
          "background": "tavern_interior_evening.png",
          "music": "gentle_gratitude.mp3",
          "dialogues": [
            {
